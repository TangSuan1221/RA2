{
  "schemaVersion": 1,
  "levelId": "fire_station",
  "layer": "L3",
  "brief": "查明消防泵去向，决定是否试泵运回营地",
  "theme": "查到能走，验泵才值得搬，搬走就要承担声响。",
  "scope": "消防站 POI；站外虚线段仅约定街区接口，街区现有三个撤离点的两个候选接入此委托。",
  "inception": {
    "location": "虚构的西雅图社区消防站，单层双贯通车位。",
    "premise": "查到能走，验泵才值得搬，搬走就要承担声响。",
    "majorGoals": "核号出情报，或在闭路试验台确认可用泵、装车交货。",
    "affectsGameplay": "站内跨层仅一座局部维修平台；静默核对、带声测试、可中止装运。",
    "introduction": "用消防泵试验台辨认真正合格的回收货。",
    "exotic": "失电的值班台留下两份相冲突的交接标记。"
  },
  "goals": {
    "narrative": "同一批泵两张工单和不同检修印记承载围困中断交接的信息。",
    "experience": "先在安全门厅辨认线索，再决定要不要用噪声换确定性，允许独行退出。",
    "function": "试泵（读表后中止或确认）。"
  },
  "arc": [
    {
      "act": 1,
      "intent": "setup",
      "tempo": 0.24,
      "durationS": [
        120,
        240
      ],
      "mechanismIds": [
        "handoff_clues",
        "quiet_alert",
        "safe_lobby"
      ],
      "tempoRef": "LV-新增-FS-ACT-1-TEMPO",
      "durationRef": "LV-新增-FS-ACT-1-DURATION"
    },
    {
      "act": 2,
      "intent": "develop",
      "tempo": 0.6,
      "durationS": [
        360,
        480
      ],
      "mechanismIds": [
        "breach_loop",
        "platform_view",
        "pump_test",
        "cart_choice"
      ],
      "tempoRef": "LV-新增-FS-ACT-2-TEMPO",
      "durationRef": "LV-新增-FS-ACT-2-DURATION"
    },
    {
      "act": 3,
      "intent": "turn",
      "tempo": 0.85,
      "durationS": [
        420,
        480
      ],
      "mechanismIds": [
        "south_shutter",
        "extract_order"
      ],
      "endTempo": 0.3,
      "tempoRef": "LV-新增-FS-ACT-3-TEMPO",
      "durationRef": "LV-新增-FS-ACT-3-DURATION",
      "endTempoRef": "LV-新增-FS-RESOLUTION-TEMPO"
    }
  ],
  "mechanisms": [
    {
      "id": "handoff_clues",
      "family": "lure",
      "verb": "核对",
      "cost": {
        "type": "time",
        "ref": "LV-新增-FS-READ-S",
        "value": 5,
        "unit": "s"
      },
      "read": {
        "channel": "silhouette",
        "telegraph": "交班册缺角、连续的轮印和双泵架上匹配的轮廓组成目视链；工单编号作文字冗余。",
        "noUi": true
      },
      "space": {
        "node": "quiet",
        "prefab": "IN-01"
      },
      "params": {
        "clueIds": [
          "sheet",
          "tracks",
          "tags"
        ],
        "requiresPower": false
      },
      "acceptance": [
        "任意顺序发现三条线索后均能回到泵架，自己核对两泵，生成一次普通位置情报。"
      ],
      "act": 1
    },
    {
      "id": "quiet_alert",
      "family": "lure",
      "verb": "复电读取",
      "cost": {
        "type": "resource",
        "ref": "LV-新增-FS-CRANK-TOOL",
        "value": 1,
        "unit": "件随身工具（占用，归还）"
      },
      "read": {
        "channel": "light",
        "telegraph": "手摇发电机插座与熄灭的复核灯在接待台同侧；恢复后故障记号闪亮。",
        "noUi": true
      },
      "space": {
        "node": "quiet",
        "prefab": "IN-03"
      },
      "params": {
        "requiresPower": true,
        "grant": "末次检修记录",
        "tool": "手摇发电机"
      },
      "acceptance": [
        "携带手摇发电机可取得末次检修记录；徒手读取交接单仍可完成侦察订单。"
      ],
      "act": 1
    },
    {
      "id": "safe_lobby",
      "family": "empty_threat",
      "verb": "试探",
      "cost": {
        "type": "time",
        "ref": "LV-新增-FS-CAUTION-S",
        "value": 5,
        "unit": "s"
      },
      "read": {
        "channel": "cover_density",
        "telegraph": "隔离入口段的破窗、弹壳、血迹、可破坏箱和多组实体端板构成战斗痕迹。外侧雨棚与接待侧门均能退回。",
        "noUi": true
      },
      "space": {
        "node": "east",
        "prefab": "CB-01"
      },
      "params": {
        "aiCount": 0,
        "coverClusters": 4,
        "areaM2": 160,
        "combatGrammar": "full",
        "escapeHatches": [
          "quiet",
          "apron"
        ],
        "refuge": "仅进入个人/同步队伍前置门厅隔离态；其他队伍无碰撞、伤害、投掷、跨界追击或封门。离开后进入共享区；撤离端不复用。",
        "reentry": "共享态回门厅保持共享；安全段不提供战斗中重置。",
        "refs": {
          "areaM2": "LV-新增-FS-SAFE-AREA",
          "coverClusters": "LV-新增-FS-SAFE-GROUPS"
        }
      },
      "acceptance": [
        "初次门厅无AI及其他队伍伤害；初见安全段的无提示警戒率达到 LV-EMPTY-CROUCH。"
      ],
      "act": 1
    },
    {
      "id": "breach_loop",
      "family": "traversal",
      "verb": "穿过",
      "cost": {
        "type": "time",
        "ref": "LV-新增-FS-QUIET-DET-S",
        "value": 10,
        "unit": "s"
      },
      "read": {
        "channel": "texture_wear",
        "telegraph": "碎砌块聚在断墙两侧，中间连续露出厨房地砖；回头能看见起居室旧门。",
        "noUi": true
      },
      "space": {
        "node": "breach",
        "prefab": "CB-01",
        "prefabUse": "断墙的原型为既有 CB-01 半身掩体分类，沿墙基两侧组合；中部通行净宽另校核。"
      },
      "params": {
        "clearW": 2.4,
        "landingDepth": 1.2,
        "clearWRef": "LV-新增-FS-BREACH-W",
        "landingDepthRef": "LV-CLEAR-W",
        "wheelRule": "破口宽度本身可容车；北侧人员出口短阶没有可供重载推车连续滚动的平面。"
      },
      "acceptance": [
        "落地净宽≥LV-CLEAR-W；厨房和起居室原门均能回员工走廊；人物以步行穿越。"
      ],
      "act": 2
    },
    {
      "id": "platform_view",
      "family": "vertical",
      "verb": "登台观察",
      "cost": {
        "type": "exposure",
        "ref": "LV-新增-FS-OBSERVE-S",
        "value": 3,
        "unit": "s"
      },
      "read": {
        "channel": "height_band",
        "telegraph": "维护平台的双向踏步和黄色边沿只引向维修间，灯下可看见试验架；隔窗能辨接驳方向。",
        "noUi": true
      },
      "space": {
        "node": "platform",
        "prefab": "TR-01"
      },
      "params": {
        "deltaY": "LV-新增-FS-PLATFORM-Y",
        "return": "原踏步可逆，另可经维修台西侧地面返回。"
      },
      "acceptance": [
        "登台可见泵架标记；双向踏步可逆且全程无强制跳落。"
      ],
      "act": 2
    },
    {
      "id": "pump_test",
      "family": "pacing",
      "verb": "试泵",
      "cost": {
        "type": "noise",
        "ref": "LV-新增-FS-PUMP-PULSE",
        "value": 1,
        "unit": "次可听事件/完成一次试验"
      },
      "read": {
        "channel": "sound",
        "telegraph": "接台后试验表指针响应，保压与回落用两种指针轨迹区分；声源挂在试验台。",
        "noUi": true
      },
      "space": {
        "node": "bench",
        "prefab": "IN-04"
      },
      "params": {
        "variation": "每局恰一合格泵；先后顺序不影响检测；中止不生成合格货，已产生的声音不会被撤回。",
        "failure": "坏泵淘汰当前序号，可测试另一台或改交情报。"
      },
      "acceptance": [
        "中止或坏泵不签发合格标记；一轮完整的合格读数只签发绑定实例的标记一次，重复读表不增产。"
      ],
      "act": 2
    },
    {
      "id": "cart_choice",
      "family": "cover",
      "verb": "制动或装运",
      "cost": {
        "type": "exposure",
        "ref": "LV-新增-FS-BRAKE-S",
        "value": 2,
        "unit": "s"
      },
      "read": {
        "channel": "silhouette",
        "telegraph": "带轮水带架的钢端板能挡，卷带缝隙通透；松闸后端板与车一起移动。",
        "noUi": true
      },
      "space": {
        "node": "cart",
        "prefab": "MV-02"
      },
      "params": {
        "heightM": 0.98,
        "heightRef": "LV-新增-FS-CART-SHIELD-H",
        "cargoHeightRef": "LV-新增-FS-CART-LOAD-H",
        "dropCargo": "停驻可松手；重货禁止进入背包、安全箱。"
      },
      "acceptance": [
        "制动插销与车速联动，移动、停驻端板都与射线碰撞一致；货物不重复装载。"
      ],
      "act": 2
    },
    {
      "id": "south_shutter",
      "family": "gate",
      "verb": "升门",
      "cost": {
        "type": "noise",
        "ref": "LV-新增-FS-SHUTTER-SOUND",
        "value": 1,
        "unit": "次开启声事件/启动"
      },
      "read": {
        "channel": "door_state",
        "telegraph": "分段卷帘、侧框手链和接驳车货台指示搬运路径。人在门内外均可操作。",
        "noUi": true
      },
      "space": {
        "node": "bay",
        "prefab": "DR-08"
      },
      "params": {
        "halfGapRef": "LV-新增-FS-SHUTTER-HALF-H",
        "fullGapRef": "LV-新增-FS-SHUTTER-FULL-H",
        "pedestrian": "门旁独立人员通口始终双向，半开时仅蹲姿过卷门。宽门全开后可推车。",
        "noise": "开始上升发一次声事件；停住可续，不删除既有噪声。",
        "dock": "对应南侧接驳货台正对这一扇门。只有该扇全开的机械状态才能放下装载桥并登记卸货。其他车门按真实净空通行，长路绕行仍能抵达停车区，但不能越过收起的装载桥结算。"
      },
      "acceptance": [
        "半开时蹲姿可过且载货推车被挡；全开后载货推车可过，门下占位时不得压住角色或货物。",
        "玩家经其他贯通门推货到南坪时能走到接驳车；装载桥收起时无法卸货，开启指定卷门并放下桥后允许卸货。"
      ],
      "act": 3
    },
    {
      "id": "extract_order",
      "family": "extraction",
      "verb": "交付并步行撤离",
      "cost": {
        "type": "irreversibility",
        "ref": "LV-新增-FS-HANDOFF",
        "value": 1,
        "unit": "份带唯一货号的寄存单"
      },
      "read": {
        "channel": "silhouette",
        "telegraph": "南侧接驳货台有与推车相齐的挡轮槽，空位与已装状态可辨；北侧足迹和出口方向标指向步道。",
        "noUi": true
      },
      "space": {
        "node": "handover",
        "prefab": "SY-03"
      },
      "params": {
        "outcome": "南侧交货仅待结算，玩家徒步从街区已配置的候选点离区才确认；北侧可交侦察。回营实际安装合格泵才记工程贡献。",
        "failure": "失去货物仍能走侦察线；死亡服从 GDD §3.2；关键物和凭据不进安全箱。"
      },
      "acceptance": [
        "同一契约货号的接驳、撤离、安装各至多入账一次；未撤离无法取得工程贡献。"
      ],
      "act": 3
    }
  ],
